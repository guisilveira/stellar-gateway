# App Config
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO

# Redis
# Use 'localhost' se rodar fora do Docker, ou 'redis' se rodar via docker-compose
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# SWAPI (External)
SWAPI_BASE_URL=https://swapi.dev/api

# Firebase Authentication (opcional em dev/test)
# Apenas necessário se quiser usar autenticação real
GOOGLE_APPLICATION_CREDENTIALS=sua_service_account_key.json
FIREBASE_WEB_API_KEY=sua_chave_secreta_aqui